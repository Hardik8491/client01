{
  "name": "samarth-electronics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:css": "node -e \"const postcss = require('postcss'); const tailwind = require('@tailwindcss/postcss'); const fs = require('fs'); const css = fs.readFileSync('src/app/globals.css', 'utf8'); postcss([tailwind()]).process(css, { from: 'src/app/globals.css' }).then(res => { fs.writeFileSync('public/compiled-tailwind.css', res.css); console.log('Tailwind compiled!'); });\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.16.1"
}
